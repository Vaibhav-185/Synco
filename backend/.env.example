# Synco backend — copy to .env and fill in (NEVER commit .env)
PORT=8000
MONGO_URI=
JWT_SECRET=
GEMINI_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@synco.app
# Comma-separated allowed frontend origin(s) for CORS. Local dev default shown.
FRONTEND_URL=http://localhost:5173
# Production example:
# FRONTEND_URL=https://your-app.vercel.app
# Optional (defaults to 10 if unset)
NOTIFY_WINDOW_MINUTES=10
